{
    "name": "assessment/sales-order-monitor",
    "type": "project",
    "description": "A compact Laravel sales order dashboard backed only by the assessment API.",
    "license": "MIT",
    "require": { "php": "^8.3", "laravel/framework": "^13.0" },
    "require-dev": { "phpunit/phpunit": "^12.0" },
    "autoload": { "psr-4": { "App\\": "app/" } },
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": "@php vendor/phpunit/phpunit/phpunit tests"
    },
    "config": { "sort-packages": true, "optimize-autoloader": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
